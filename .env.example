# Local preview defaults to 127.0.0.1:4194
PREVIEW_PORT=4194
AUTH_ORIGIN=http://127.0.0.1:4194
# Google OAuth Web application; add this exact redirect URI in Google Cloud:
# http://127.0.0.1:4194/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional private one-time administrator setup token. Leave empty for a local generated token.
ADMIN_SETUP_TOKEN=
# Optional image storage location; defaults to .local-data/uploads
# PERSIA_UPLOAD_DIR=

# Public HTTPS domain for canonical URLs, sharing and sitemap. Leave blank in local preview.
SITE_URL=
# Enable indexing only when the public site is ready. Local preview remains noindex.
SEO_INDEXING=false

# Public Node hosting: provider supplies PORT; HTTPS is terminated by its proxy.
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=8080
# AUTH_ORIGIN=https://your-assigned-hostname
# PERSIA_DATA_DIR=/app/.local-data
# TRUST_PROXY_HOPS=1
# Mount a persistent volume at PERSIA_DATA_DIR before deployment.
# RAILWAY_RUN_UID=0
# Railway mounts its volume as root; this override makes the mounted directory writable.
# Railway's RAILWAY_PUBLIC_DOMAIN or Render's RENDER_EXTERNAL_URL can supply the origin.
